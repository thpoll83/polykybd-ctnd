# PolyKybd CTND — station configuration
# Copy this file to config/config.yaml and edit for your hardware.
# config/config.yaml is gitignored so git pull will never overwrite your settings.

# GPIO pin assignments (BCM numbering)
gpio:
  left_run:      17
  left_bootsel:  18
  right_run:     22
  right_bootsel: 23
  # inverted: true  = NPN transistor circuit (GPIO HIGH → transistor ON → pin LOW = asserted)
  # inverted: false = direct drive           (GPIO LOW  = pin LOW = asserted)
  inverted: true

# uhubctl — USB hub and port assignments
# Find your hub location by running: uhubctl
usb:
  hub_location: "1-1"
  left_port:  1
  right_port: 2

# QMK HID identifiers
# Find these in keyboards/polykbd/config.h in qmk_firmware
qmk:
  vendor_id:  0x2021  # PolyTasten PolyKybd Split72
  product_id: 0x2007
  # HID usage pages (QMK standard defaults — only change if your firmware differs)
  console_usage_page: 0xFF31
  console_usage:      0x0074
  raw_usage_page:     0xFF61  # from RAW_USAGE_PAGE in split72/config.h
  raw_usage:          0x0062  # from RAW_USAGE_ID in split72/config.h
  mass_storage_label: "RPI-RP2"

# Web UI
ui:
  # The control UI is UNAUTHENTICATED and can flash firmware, cut USB power, drive
  # GPIO and re-register the runner. The Chromium kiosk loads http://localhost:5000,
  # so keep this on loopback. Only set a network bind (e.g. "0.0.0.0") together with
  # allow_lan: true, and only on a trusted network — see HIL-1 in the security notes.
  host: "127.0.0.1"
  # allow_lan: true   # opt-in to bind `host` on a network interface (loopback enforced otherwise)
  #
  # ⚠️ allow_lan grants FULL, UNAUTHENTICATED rig control to every host that can
  # reach the port (HIL-4): there is no login, no token and no per-event check on
  # ANY of the SocketIO handlers — flash, usb_power, bootsel, reset_board,
  # set_handedness, run_tests, run_perf, run_diagnostics, restart_runner,
  # reregister_runner and update_now are all reachable by anyone who opens the
  # page. It also widens the SocketIO CORS origin to "*", so a page in the
  # operator's browser can drive the rig too. Treat it as "anyone on this network
  # may reflash the keyboard and run commands on the Pi", and prefer an SSH
  # tunnel to the loopback bind over turning it on.
  port: 5000

# Self-update (optional)
# The polykybd-update.timer periodically fetches this branch and, when it gains
# new commits AND the rig is idle, fast-forwards the checkout, reinstalls deps if
# requirements.txt changed, and restarts the station — so a `git push` to the
# branch deploys itself with no SSH. The UI header shows an UPDATE badge (current
# / N behind) and an "Update" button to apply on demand. Defaults to `main`.
update:
  branch: main

# GitHub Actions CI status indicator (optional)
# The UI polls this repo and shows a badge when a job is running, so you know not
# to flash while CI is verifying. It also shows a "RUNNER" badge and an on-screen
# "Diagnose Runner" button to troubleshoot why the self-hosted runner isn't
# picking up jobs.
github:
  repo: "thpoll83/qmk_firmware"
  token: ""  # personal access token. 'actions:read' is enough for the CI badge;
             # the RUNNER badge / diagnostics also need repo-admin
             # ('administration:read') to query self-hosted runner status, and
             # minting registration tokens (Re-register) needs it read/write.
             # ⚠️ This is a plaintext secret on disk: keep config.yaml 0600 and
             # owned by the station user (setup.sh enforces it — HIL-6), and
             # scope the PAT to this one repo.
  # Labels the HIL job requires — must match `runs-on:` in qmk-test.yml.
  # The RUNNER badge turns green only when an online runner advertises all of these.
  runner_labels: [self-hosted, polykybd-ctnd]
